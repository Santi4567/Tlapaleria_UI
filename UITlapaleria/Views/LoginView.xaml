<Window x:Class="UITlapaleria.Views.LoginView"
        Style="{StaticResource MaterialDesignWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Login" Height="500" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <materialDesign:Card UniformCornerRadius="25" Background="LightGray" materialDesign:ElevationAssist.Elevation="Dp4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.8*"/>
                <ColumnDefinition Width="6.2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="40,0">

                <materialDesign:PackIcon Kind="StoreOutline" Width="50" Height="50" 
                                         HorizontalAlignment="Center" Foreground="#E53935" Margin="0,0,0,10"/>

                <TextBlock Text="Tlapaleria LEO" FontSize="28" FontWeight="ExtraBold" 
                           HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,40"/>

                <TextBlock Text="Usuario" Foreground="Black" FontWeight="Medium" Margin="5,0,0,5"/>
                <Border BorderBrush="#F73811" BorderThickness="1.5" CornerRadius="10" Margin="0,0,0,20">
                    <TextBox x:Name="txtUser" Text="{Binding UsuarioText, UpdateSourceTrigger=PropertyChanged}" 
                             BorderThickness="0" Background="Transparent" 
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                             VerticalContentAlignment="Center" Padding="12,8" FontSize="15"/>
                </Border>

                <TextBlock Text="Contraseña" Foreground="Black" FontWeight="Medium" Margin="5,0,0,5"/>
                <Border BorderBrush="#F73811" BorderThickness="1.5" CornerRadius="10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38*"/>
                            <ColumnDefinition Width="191*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="txtPasswordHidden" BorderThickness="0" Background="Transparent"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                     VerticalContentAlignment="Center" Padding="12,8" Grid.ColumnSpan="2"/>

                        <TextBox x:Name="txtPasswordVisible" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                 VerticalContentAlignment="Center" Padding="12,8" Grid.ColumnSpan="2"/>

                        <ToggleButton x:Name="btnShowPass" Click="btnShowPass_Click" Grid.Column="2" Style="{StaticResource MaterialDesignActionToggleButton}"
                                      Width="30" Height="30" Background="Transparent" BorderBrush="Transparent" Margin="0,1,0,1">
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="Eye" Foreground="#E53935"/>
                            </materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="EyeOff" Foreground="Gray"/>
                        </ToggleButton>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding MensajeError}" Foreground="Red" FontWeight="Bold" 
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Button Content="INGRESAR" Click="btnIngresar_Click" Height="45" Width="160"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#F73811" BorderBrush="#F73811"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
            </StackPanel>

            <Grid Grid.Column="1">
                <Image Source="/Images/login.jpg" Stretch="UniformToFill">
                    <Image.Effect>
                        <BlurEffect Radius="20" RenderingBias="Quality"/>
                    </Image.Effect>
                </Image>

                <Rectangle Fill="Black" Opacity="0.5"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="¡Bienvenido!" FontSize="42" FontWeight="Thin" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sistema de Punto de Venta" FontSize="18" Foreground="White" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="—" Foreground="White" Width="40" Click="btnMinimize_Click"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="✕" Foreground="White" Width="45" Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>